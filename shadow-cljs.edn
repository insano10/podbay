;; Source paths and dependencies live in deps.edn — see :deps below.
{:deps true

 ;; Two ports, two origins — and that separation is load-bearing, not
 ;; tidiness. solid-client-authn-browser keeps its session in
 ;; localStorage, which is per-origin, so two apps sharing one origin
 ;; share one session: whichever loads second silently re-authenticates
 ;; using the *other* app's stored redirect URL and lands the user
 ;; there. Separate ports give each its own storage.
 :dev-http {8080 "apps/comms/public"
            8081 "apps/airlock/public"}

 :builds
 {;; `npm test`. Only the pure parts of the app are covered — the
  ;; mention scanner and the container walk — because everything else
  ;; here is a conversation with a pod, and a test that mocks one ends
  ;; up asserting what we believe the server does rather than what it
  ;; does. Those beliefs have been wrong often enough that a green
  ;; suite built on them would be worse than none.
  :test
  {:target :node-test
   :output-to "out/node-tests.js"
   :ns-regexp "-test$"}

  ;; The social feed, published at /comms/
  :comms
  {:target :browser
   :output-dir "apps/comms/public/js"
   :asset-path "js"
   :modules {:main {:init-fn podbay.comms.core/init}}

   ;; The published app identifies itself with the client identifier
   ;; document beside it, so it presents a stable identity instead of
   ;; registering a throwaway client on every login. See "Client
   ;; identity" in the README.
   :release
   {:closure-defines
    {podbay.shared.auth/client-id
     "https://insano10.github.io/podbay/comms/clientid.jsonld"
     podbay.shared.auth/storage-prefix "podbayComms:"
     podbay.shared.auth/client-name "Podbay Comms"}}

   ;; Local development uses a separate published identity whose
   ;; redirect URIs are localhost only, so the real app's identity never
   ;; vouches for a loopback redirect. Note the document is fetched by
   ;; the identity provider, not the browser — hence a public URL for a
   ;; localhost-only client.
   ;;
   ;; The client-id line is discarded until a Pages deploy publishes the
   ;; /feed/ layout: a client_id the provider can't dereference fails the
   ;; whole login with a 500, so dev falls back to dynamic registration
   ;; meanwhile. Re-enable it, and the browser's, after a deploy.
   :dev
   {:closure-defines
    {podbay.shared.auth/storage-prefix "podbayComms:"
     podbay.shared.auth/client-name "Podbay Comms"
     podbay.shared.auth/client-id
     "https://insano10.github.io/podbay/comms/clientid-dev.jsonld"}}}

  ;; The pod file browser, published at /airlock/. Shares only
  ;; podbay.shared.*, and has its own client identity so a consent screen
  ;; names what is actually asking for access.
  :airlock
  {:target :browser
   :output-dir "apps/airlock/public/js"
   :asset-path "js"
   :modules {:main {:init-fn podbay.airlock.core/init}}

   :release
   {:closure-defines
    {podbay.shared.auth/client-id
     "https://insano10.github.io/podbay/airlock/clientid.jsonld"
     podbay.shared.auth/storage-prefix "podbayAirlock:"
     podbay.shared.auth/client-name "Podbay Airlock"}}

   :dev
   {:closure-defines
    {podbay.shared.auth/storage-prefix "podbayAirlock:"
     podbay.shared.auth/client-name "Podbay Airlock"
     podbay.shared.auth/client-id
     "https://insano10.github.io/podbay/airlock/clientid-dev.jsonld"}}}}}
