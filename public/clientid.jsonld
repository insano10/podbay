{
  "@context": ["https://www.w3.org/ns/solid/oidc-context.jsonld"],

  "client_id": "https://insano10.github.io/solid-social/clientid.jsonld",
  "client_name": "Solid Social",
  "client_uri": "https://insano10.github.io/solid-social/",

  "redirect_uris": [
    "https://insano10.github.io/solid-social/",
    "https://insano10.github.io/solid-social/index.html"
