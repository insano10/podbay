{
  "@context": [
    "https://www.w3.org/ns/solid/oidc-context.jsonld"
  ],
  "client_id": "https://insano10.github.io/solid-social/feed/clientid-dev.jsonld",
  "client_name": "Solid Social (local development)",
  "client_uri": "https://github.com/insano10/solid-social",
  "redirect_uris": [
    "http://localhost:8080/",
    "http://localhost:8080/index.html"
  ],
  "post_logout_redirect_uris": [
    "http://localhost:8080/"
  ],
  "scope": "openid profile offline_access webid",
  "grant_types": [
    "authorization_code",
    "refresh_token"
  ],
  "response_types": [
    "code"
  ],
  "token_endpoint_auth_method": "none",
  "application_type": "web"
}
